# Plantilla: la instala instalar-en-casa.sh reemplazando @USER@ y @CONF@.
[Unit]
Description=SexyRose: traer copias del servidor, verificarlas y rotarlas
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@USER@
Environment=SR_COPIAS_CONF=@CONF@
ExecStart=/usr/local/bin/sexyrose-traer-copias
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3h
# Endurecimiento: el script solo necesita leer la config y escribir en la carpeta de destino.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

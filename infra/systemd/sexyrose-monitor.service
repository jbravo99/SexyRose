# Plantilla: la instala infra/server/install-timers.sh reemplazando @USER@ y @REPO_DIR@.
[Unit]
Description=SexyRose: chequeo de salud (app, disco, copias) con aviso por Telegram
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@REPO_DIR@
ExecStart=/usr/bin/env bash @REPO_DIR@/infra/monitor/check.sh
TimeoutStartSec=2min

# Plantilla: la instala infra/server/install-timers.sh.
[Unit]
Description=SexyRose: copia diaria, 03:15 UTC (la PC de casa la trae a las 05:15 UTC)

[Timer]
# Antes del posible reinicio automático de las 04:30.
OnCalendar=*-*-* 03:15:00
RandomizedDelaySec=10m
Persistent=true

[Install]
WantedBy=timers.target

# Plantilla: la instala infra/server/install-timers.sh reemplazando @USER@ y @REPO_DIR@.
[Unit]
Description=SexyRose: copia diaria de la base (pg_dump + age)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@REPO_DIR@
ExecStart=/usr/bin/env bash @REPO_DIR@/infra/backup/backup.sh
Nice=10
IOSchedulingClass=idle
